# Supabase. For local development, `supabase status -o env` prints these
# (API_URL and SERVICE_ROLE_KEY). On Vercel they come from the Supabase integration.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sign-in: one shared password, and a secret of at least 32 characters that
# encrypts the session cookie.
AUTH_PASSWORD=choose-a-password
AUTH_PASSWORD_SECRET=at-least-32-characters-of-random-text

# Bearer secret for the cron and sync routes (/api/cron/*, /api/sync).
SYNC_API_SECRET=

# Optional: Enable mock data mode for development/testing
USE_MOCK_DATA=false

ANTHROPIC_API_KEY=               # Anthropic API key for AI summary generation and entry parsing

# Substack auto-import (#149): the public Substack handle whose subscriptions the daily
# /api/cron/substack-import job reads (e.g. "examplereader" for substack.com/@examplereader).
# Non-secret — uses the public profile endpoint, no cookie/auth. If unset, the import no-ops.
SUBSTACK_HANDLE=

# Askwho Casts private podcast feed (#226). Bearer-secret URL from the app's
# Feed page — treat like a password; rotate in-app if it leaks.
ASKWHOCASTS_FEED_URL=

# iOS Share Sheet (#191): bearer token the "Save to Reading List" iOS Shortcut sends to
# POST /api/add-entry from outside a browser session. Distinct from SYNC_API_SECRET so a
# leaked Shortcut can't reach the cron/sync endpoints. Generate a strong value (e.g.
# `openssl rand -hex 32`) and set the SAME value here (Vercel env) and in the Shortcut.
SHARE_API_SECRET=
