<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.claude.substack-progress-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/YOUR_USER/Programming/reading-list-worktrees/reading-list/substack-progress-sync/launchd/run-sync.sh</string>
	</array>
	<!-- No Hour key: launchd treats the omitted field as a wildcard, so the
	     job fires every hour at :30 (#222, was once daily at 08:30). -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USER/.claude/logs/substack-progress-sync-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USER/.claude/logs/substack-progress-sync-stderr.log</string>
</dict>
</plist>
