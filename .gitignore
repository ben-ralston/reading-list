# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
.claude/hooks/node_modules

# Claude Code harness runtime state
.claude/scheduled_tasks.lock

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (but allow .env.example for documentation)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# general
.DS_Store
.AppleDouble
.LSOverride
Icon[]
.env*.local

# Supabase local development
supabase/.temp
supabase/.branches

.pnpm-store/

# Generated reports from scripts/rss-backfill-*.ts
scratch/
# Production data dumps (regenerate with ./run db-pull-prod) — never commit prod data
prod_data_dump.sql
# Claude Code autopilot session markers (local state, never commit)
.claude/.autopilot
.claude/.autopilot-halted
# Per-SHA /save-work review markers (session artifacts, not source)
.claude/.review-*.json
.qa-media/
